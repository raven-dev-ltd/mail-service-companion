# Copy to .env alongside compose.yml. Never include this file's real secrets in an APK.
# REQUIRED: fixed TLS IMAP endpoint used only to verify employee sign-in.
COMPANION_IMAP_HOST=mail.example.com
COMPANION_IMAP_PORT=993
# implicit-tls (usually 993), or starttls (usually 143). No plaintext mode.
COMPANION_IMAP_SECURITY=implicit-tls
COMPANION_ALLOWED_DOMAINS=example.com
# Exact comma-separated origins, never '*'.
COMPANION_ALLOWED_ORIGINS=https://localhost,capacitor://localhost

# Docker: private host port for your HTTPS reverse proxy; change if occupied.
COMPANION_HTTP_PORT=8080
# Public subdomain is configured in DNS + reverse proxy + Maker, not in this service.
# Native binary only: Compose fixes these to 0.0.0.0:8080 and /data inside container.
COMPANION_LISTEN=127.0.0.1:8080
COMPANION_DATA_DIR=./data
# Optional comma-separated companion features to turn off. Empty enables every
# implemented feature whose required integration is configured. Valid names:
# contacts,contactLists,templates,labels,scheduledSend,campaigns,push
COMPANION_DISABLED_FEATURES=
# feature-routing.json is generated in COMPANION_DATA_DIR on startup or with
# --configure. It contains public routing/check results, never mailbox secrets.

# OPTIONAL scheduled messages/campaigns: disabled | service | ip-allowlist.
# service uses an ADMIN relay identity. ip-allowlist requires a tightly restricted
# server-side source-IP relay rule. Neither mode uses an employee mailbox password.
COMPANION_SMTP_MODE=disabled
COMPANION_SMTP_HOST=
COMPANION_SMTP_PORT=587
# starttls (587) or implicit-tls (465), with verified certificates.
COMPANION_SMTP_SECURITY=starttls
COMPANION_SMTP_USERNAME=
# Container path, NOT a password. Required only in service mode.
# Example: /run/secrets/smtp-password
COMPANION_SMTP_PASSWORD_FILE=

# OPTIONAL FCM event push: BOTH files must be configured, in the SAME Firebase
# project as Maker's public google-services.json. Paths here are inside container.
# Example: /run/secrets/firebase-private.json (private Admin SDK service account)
COMPANION_FCM_CREDENTIALS=
# Example: /run/secrets/mail-events-secret (openssl rand -hex 32)
COMPANION_EVENT_SECRET_FILE=
# Host directory mounted read-only at /run/secrets. Restrict permissions; see guide.
COMPANION_SECRETS_DIR=./secrets

# No employee password encryption key is needed or supported.
# Event producer only (not read by service):
# COMPANION_EVENT_URL=https://mail-features.example.com/api/integrations/mail-events
# COMPANION_EVENT_SECRET_FILE=/secure/path/mail-events-secret
# Optional Dovecot adapter: configure its separate systemd EnvironmentFile.
# COMPANION_EVENT_SPOOL=/var/spool/mail-companion-events
# COMPANION_EVENT_LOCK=/run/mail-companion-events/adapter.lock
# See integrations/dovecot24/README.md; these are NOT companion container settings.
